# Supabase (obrigatório para login e persistência na nuvem)
# Projeto: pokebinder (sa-east-1)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Ingestão de catálogo (CLI only — NUNCA expor no frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# TCGdex API (sync incremental)
TCGDEX_API_URL=https://api.tcgdex.net/v2

# Sync tuning
SYNC_BATCH_SIZE=50
SYNC_RATE_LIMIT=200
SYNC_TIMEOUT=15000
SYNC_MAX_RETRIES=4

# Opcional: path local do clone tcgdex/cards-database para import em massa
# TCGDEX_DATA_PATH=./data/cards-database

# No dashboard Supabase → Authentication → URL Configuration:
# Site URL: http://localhost:5173 (dev) ou a URL de produção
# Redirect URLs: http://localhost:5173/** e a URL de produção/**

# Vercel: adicione as mesmas variáveis em Project Settings → Environment Variables

# Pokémon TCG API (opcional, só serverless — melhora rate limit e estabilidade)
# Obtenha em https://dev.pokemontcg.io/ → Vercel: POKEMON_TCG_API_KEY (sem VITE_)
# POKEMON_TCG_API_KEY=
